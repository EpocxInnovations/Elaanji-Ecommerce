# --- Database ---
DATABASE_URL=postgresql+psycopg2://garments_user:garments_pass@localhost:5432/garments_db

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Cloudinary (image storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Store defaults ---
FREE_SHIPPING_THRESHOLD=999
DEFAULT_SHIPPING_FEE=79

# --- Environment ---
ENVIRONMENT=development

# --- Password-reset email delivery ---
# Configure either Resend or SMTP. Never expose OTPs through logs or API responses.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
